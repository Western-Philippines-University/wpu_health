<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Block direct access to environment and dependency manifests
    RewriteRule ^\.env - [F,L]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json)$ - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)/ - [F,L]
    RewriteRule ^(artisan|Dockerfile)$ - [F,L]

    # Legacy portal asset URLs → static files (avoid Laravel 500/HTML responses).
    RewriteRule ^portal/assets/(.*)$ unified_portal/assets/$1 [L]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    # Let unified_portal handle its own extensionless *.php routing (unified_portal/.htaccess).
    RewriteCond %{REQUEST_URI} !/unified_portal/
    RewriteRule ^ index.php [L]
</IfModule>
